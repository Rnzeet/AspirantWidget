<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/exam_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SSC CGL"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2c3e50" />

        <TextView
            android:id="@+id/exam_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Combined Graduate Level"
            android:textSize="11sp"
            android:textColor="#7f8c8d"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Countdown Box -->
    <LinearLayout
        android:id="@+id/countdown_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4CAF50"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/days_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#fff" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Days Left"
                android:textSize="10sp"
                android:textColor="#fff"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Streak -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#fff" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streak"
                android:textSize="9sp"
                android:textColor="#fff" />

        </LinearLayout>

    </LinearLayout>

    <!-- Motivation -->
    <TextView
        android:id="@+id/motivation_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You're doing great! Keep up the momentum 🚀"
        android:textSize="11sp"
        android:textColor="#2c3e50"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:lines="2"
        android:ellipsize="end" />

</LinearLayout>
